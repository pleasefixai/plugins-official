{
  "id": "airtable",
  "name": "Airtable",
  "description": "Bases, tables and records from your Airtable workspace.",
  "group": "forms_data",
  "url": "https://mcp.airtable.com/mcp",
  "auth": {
    "scopes": [
      "data.records:read",
      "data.records:write",
      "schema.bases:read",
      "schema.bases:write",
      "data.recordComments:read",
      "data.recordComments:write",
      "workspacesAndBases:read"
    ],
    "discovery": {
      "mode": "discover"
    },
    "registration": {
      "mode": "dcr"
    }
  },
  "writes": true
}
