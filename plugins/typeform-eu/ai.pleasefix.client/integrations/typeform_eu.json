{
  "id": "typeform_eu",
  "name": "Typeform EU",
  "description": "Forms, questions and responses from a Typeform account on EU data residency.",
  "group": "forms_data",
  "url": "https://api.eu.typeform.com/mcp",
  "auth": {
    "scopes": [
      "accounts:read",
      "automations:read",
      "automations:write",
      "contacts:read",
      "contacts:write",
      "forms:read",
      "forms:write",
      "responses:read",
      "responses:write",
      "insights:read",
      "webhooks:read",
      "webhooks:write",
      "workspaces:read",
      "workspaces:write"
    ],
    "discovery": {
      "mode": "discover"
    },
    "registration": {
      "mode": "dcr"
    }
  },
  "writes": true,
  "regional_sibling": "typeform"
}
